    {
      "name": "Users",
      "description": "Profilo e ruoli self-service (card F2-01). Eseguire in ordine, dopo il login: Me salva userId.",
      "item": [
        {
          "name": "Me (200)",
          "event": [
            {
              "listen": "test",
              "script": {
