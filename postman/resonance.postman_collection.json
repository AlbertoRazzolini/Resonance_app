            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/resend-code",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "resend-code"]
            },
            "description": "Errore significativo. Senza il campo email: 400 VALIDATION_ERROR con fields.email."
          },
          "response": []
